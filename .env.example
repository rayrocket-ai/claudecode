# =============================================
# AI Real Estate Document Generator - Config
# =============================================

# --- REQUIRED: Telegram Bot ---
TELEGRAM_BOT_TOKEN=

# --- REQUIRED: AI (Claude) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- REQUIRED: REALM / TRREB Login ---
REALM_USERNAME=
REALM_PASSWORD=
REALM_URL=https://torontomls.net
REALM_SSO_URL=https://sso.ampre.ca/realms/trreb/protocol/openid-connect/auth

# --- REQUIRED: Brokerage Info ---
BROKERAGE_NAME=
BROKERAGE_PHONE=
BROKERAGE_FAX=
BROKERAGE_EMAIL=
BROKERAGE_ADDRESS=

# --- REQUIRED: Access Control ---
# Comma-separated Telegram user IDs. Empty = deny ALL users.
# Get your ID by messaging @userinfobot on Telegram.
AUTHORIZED_USER_IDS=

# --- OPTIONAL: BrokerBay Showings ---
BROKERBAY_EMAIL=
BROKERBAY_PASSWORD=
BROKERBAY_BASE_URL=https://www.brokerbay.com
SESSION_PATH=./session/brokerbay.json
SHOWING_POLL_INTERVAL=120

# --- OPTIONAL: Google Maps ---
GOOGLE_MAPS_API_KEY=

# --- OPTIONAL: Browser Settings ---
BROWSER_HEADLESS=true
BROWSER_SLOWMO=100

# --- OPTIONAL: DocuSign ---
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_PRIVATE_KEY_PATH=
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi

# --- OPTIONAL: Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- OPTIONAL: SkySlope ---
SKYSLOPE_API_KEY=
SKYSLOPE_API_URL=https://api.skyslope.com

# --- OPTIONAL: Campaign Dashboard (docker compose service "dashboard") ---
# Shared secret for API writes (X-Dashboard-Key header). Empty = writes disabled.
DASHBOARD_KEY=
DASHBOARD_PORT=8080
# Where campaign data is stored inside the container (volume-mounted).
DASHBOARD_STORE=storage/dashboard.json

# --- OPTIONAL: Meta (Facebook/Instagram) Marketing API ---
# See META_ADS_SETUP.md for how to get each of these.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_INSTAGRAM_ID=
META_API_VERSION=v21.0
