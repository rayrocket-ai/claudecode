ANTHROPIC_API_KEY=your_key_here
DATABASE_URL=sqlite:///./content.db

# ── AI Receptionist (Vapi) ────────────────────────────────────────────────
# Configure in the Vapi dashboard on your assistant:
#   - Advanced → Server URL: /voice/vapi/webhook on this app
#   - Advanced → Server URL Secret: any string; paste the same value below
#   - Assistant → Analysis: enable Summary + Structured Data
#     (define fields: name, callback_number, reason)
VAPI_SECRET=

# Where the call recap email is sent
RECEPTIONIST_EMAIL=

# SMTP (used by both the receptionist recap and the daily script digest)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
