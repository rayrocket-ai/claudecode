# =============================================
# Off-Market Property Dashboard — configuration
# Copy to `.env` and fill in. `.env` is gitignored.
# =============================================

# --- Database ---
# SQLite for local dev; Postgres in prod (Fly).
DATABASE_URL=sqlite+aiosqlite:///storage/dashboard.db
# Example prod: postgresql+asyncpg://user:pass@host:5432/dashboard

# --- Web / auth ---
JWT_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me-too
WEB_BASE_URL=http://localhost:8000

# --- REALM / TRREB ---
REALM_USERNAME=
REALM_PASSWORD=
REALM_URL=https://torontomls.net
REALM_SSO_URL=https://sso.ampre.ca/realms/trreb/protocol/openid-connect/auth

# --- GHL (SMS relay for REALM 2FA) ---
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_PHONE_NUMBER=
GHL_API_BASE=https://services.leadconnectorhq.com
# Seconds to wait for the 2FA SMS to arrive before giving up
GHL_MFA_POLL_SECONDS=90

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=

# --- AI (optional — fuzzy address fallback, listing summaries) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- Browser ---
BROWSER_HEADLESS=true
BROWSER_SLOWMO=50

# --- Ingestion ---
BACKFILL_DAYS=180
SCRAPER_TIMEZONE=America/Toronto
