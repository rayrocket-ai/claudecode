ANTHROPIC_API_KEY=your_key_here
DATABASE_URL=sqlite:///./content.db

# Facebook comment agent (all four required to send/receive)
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_APP_SECRET=
FB_VERIFY_TOKEN=
FB_GRAPH_VERSION=v21.0

# Google Sheets — master listings sync
# Paste the entire service-account JSON as a single-line string.
GOOGLE_SERVICE_ACCOUNT_JSON=
LISTINGS_SHEET_ID=
LISTINGS_SHEET_TAB=
