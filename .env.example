# =============================================
# AI Real Estate Document Generator - Config
# =============================================

# --- REQUIRED: Telegram Bot ---
TELEGRAM_BOT_TOKEN=

# --- REQUIRED: AI (Claude) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- REQUIRED: REALM / TRREB Login ---
REALM_USERNAME=
REALM_PASSWORD=
REALM_URL=https://torontomls.net
REALM_SSO_URL=https://sso.ampre.ca/realms/trreb/protocol/openid-connect/auth

# --- REQUIRED: Brokerage Info ---
BROKERAGE_NAME=
BROKERAGE_PHONE=
BROKERAGE_FAX=
BROKERAGE_EMAIL=
BROKERAGE_ADDRESS=

# --- OPTIONAL: Access Control ---
# Comma-separated Telegram user IDs. Empty = allow all.
AUTHORIZED_USER_IDS=

# --- OPTIONAL: Browser Settings ---
BROWSER_HEADLESS=true
BROWSER_SLOWMO=100

# --- OPTIONAL: DocuSign ---
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_PRIVATE_KEY_PATH=
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi

# --- OPTIONAL: Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- OPTIONAL: Higgsfield (Tour Video Generation) ---
# Backend: "api" (default) uses Higgsfield Cloud API via the higgsfield-client SDK.
#          "browser" uses Playwright on the higgsfield.ai web UI (needs SSO login).
HIGGSFIELD_BACKEND=api
# Credentials from https://cloud.higgsfield.ai/api-keys (ID + secret pair)
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
HIGGSFIELD_MODEL=standard
# Optional: override the image-to-video endpoint ID used by the SDK
# Examples: higgsfield/dop/v1/image-to-video, higgsfield/soul/v1/image-to-video
HIGGSFIELD_I2V_ENDPOINT=
TOUR_MAX_PHOTOS=10
TOUR_CLIP_DURATION=5

# --- OPTIONAL: SkySlope ---
SKYSLOPE_API_KEY=
SKYSLOPE_API_URL=https://api.skyslope.com

# --- OPTIONAL: Google Sheets (Higgsfield tracking sheet) ---
# Provide ONE of:
#   (a) Service-account JSON path for private sheets
#   (b) Published-CSV URL for public sheets (no auth)
GOOGLE_SHEETS_CREDENTIALS_PATH=
GOOGLE_SHEETS_CSV_URL=
# Sheet id + worksheet name if using service account
HIGGSFIELD_SHEET_ID=
HIGGSFIELD_WORKSHEET_NAME=Sheet1
# Column headers in the sheet (case-insensitive, trimmed)
HIGGSFIELD_ADDRESS_COLUMN=address
HIGGSFIELD_VIDEO_URL_COLUMN=video_url
HIGGSFIELD_STATUS_COLUMN=status
HIGGSFIELD_OUTPUT_COLUMN=final_video_url

# --- OPTIONAL: Voiceover (ElevenLabs TTS) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# --- OPTIONAL: Voiceover tuning ---
VOICEOVER_SCENE_THRESHOLD=0.35
VOICEOVER_MIN_SCENE_SECONDS=1.5
VOICEOVER_WORDS_PER_SECOND=2.4
