ANTHROPIC_API_KEY=your_key_here
DATABASE_URL=sqlite:///./content.db

# ── AI Receptionist (Twilio + ElevenLabs) ─────────────────────────────────
# Twilio: only the auth token is needed (no SDK calls — TwiML is XML)
TWILIO_AUTH_TOKEN=

# ElevenLabs voice for the AI receptionist
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Public URL of this app (Railway gives you one). Used in TwiML <Play> URLs.
PUBLIC_BASE_URL=https://your-app.up.railway.app

# Where the call recap email is sent
RECEPTIONIST_EMAIL=

# SMTP (also used by the daily script digest)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
