ANTHROPIC_API_KEY=your_key_here
DATABASE_URL=sqlite:///./content.db

# ── AI Receptionist (ElevenLabs Agent → Twilio integration) ──────────────
# Configure once in the ElevenLabs dashboard:
#   - Conversational AI → Agents → your agent → connect Twilio number
#   - Settings → Webhooks → Post-call → URL: /voice/elevenlabs/post-call on this app
#   - Copy the generated "Webhook secret" into ELEVENLABS_WEBHOOK_SECRET
ELEVENLABS_WEBHOOK_SECRET=

# Where the call recap email is sent
RECEPTIONIST_EMAIL=

# SMTP (used by both the receptionist recap and the daily script digest)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
