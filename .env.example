# =============================================
# AI Real Estate Document Generator - Config
# =============================================

# --- REQUIRED: Telegram Bot ---
TELEGRAM_BOT_TOKEN=

# --- REQUIRED: AI (Claude) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- REQUIRED: REALM / TRREB Login ---
REALM_USERNAME=
REALM_PASSWORD=
REALM_URL=https://torontomls.net
REALM_SSO_URL=https://sso.ampre.ca/realms/trreb/protocol/openid-connect/auth

# --- REQUIRED: Brokerage Info ---
BROKERAGE_NAME=
BROKERAGE_PHONE=
BROKERAGE_FAX=
BROKERAGE_EMAIL=
BROKERAGE_ADDRESS=

# --- OPTIONAL: Access Control ---
# Comma-separated Telegram user IDs. Empty = allow all.
AUTHORIZED_USER_IDS=

# --- OPTIONAL: Browser Settings ---
BROWSER_HEADLESS=true
BROWSER_SLOWMO=100

# --- OPTIONAL: DocuSign ---
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_PRIVATE_KEY_PATH=
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi

# --- OPTIONAL: Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- OPTIONAL: SkySlope ---
SKYSLOPE_API_KEY=
SKYSLOPE_API_URL=https://api.skyslope.com

# =============================================
# Social Media Dashboard
# =============================================

# --- Dashboard Settings ---
DASHBOARD_SECRET_KEY=change-me-in-production
DASHBOARD_DB_PATH=storage/dashboard.db
DEMO_MODE=true

# --- Social Platform OAuth (optional, demo mode works without these) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
