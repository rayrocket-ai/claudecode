# =============================================
# AI Real Estate Document Generator - Config
# =============================================

# --- REQUIRED: Telegram Bot ---
TELEGRAM_BOT_TOKEN=

# --- REQUIRED: AI (Claude) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- REQUIRED: REALM / TRREB Login ---
REALM_USERNAME=
REALM_PASSWORD=
REALM_URL=https://torontomls.net
REALM_SSO_URL=https://sso.ampre.ca/realms/trreb/protocol/openid-connect/auth

# --- REQUIRED: Brokerage Info ---
BROKERAGE_NAME=
BROKERAGE_PHONE=
BROKERAGE_FAX=
BROKERAGE_EMAIL=
BROKERAGE_ADDRESS=

# --- REQUIRED: Access Control ---
# Comma-separated Telegram user IDs. Empty = deny ALL users.
# Get your ID by messaging @userinfobot on Telegram.
AUTHORIZED_USER_IDS=

# --- OPTIONAL: BrokerBay Showings ---
BROKERBAY_EMAIL=
BROKERBAY_PASSWORD=
BROKERBAY_BASE_URL=https://www.brokerbay.com
SESSION_PATH=./session/brokerbay.json
SHOWING_POLL_INTERVAL=120

# --- OPTIONAL: Google Maps ---
GOOGLE_MAPS_API_KEY=

# --- OPTIONAL: Listing Launch Agent (marketing) ---
# The /launch command always drafts a full campaign with Claude. These only
# enable optional direct delivery — leave blank to get ready-to-paste output.
MARKETING_BRAND_VOICE=warm, professional, concise
MARKETING_SEGMENT=
MARKETING_OPEN_HOUSE_DURATION=120
BOOSEND_API_KEY=
GAMMA_API_KEY=
HIGGSFIELD_API_KEY=
LISTING_AUTOLAUNCH=false

# --- OPTIONAL: Browser Settings ---
BROWSER_HEADLESS=true
BROWSER_SLOWMO=100

# --- OPTIONAL: DocuSign ---
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_PRIVATE_KEY_PATH=
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi

# --- OPTIONAL: Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- OPTIONAL: SkySlope ---
SKYSLOPE_API_KEY=
SKYSLOPE_API_URL=https://api.skyslope.com
