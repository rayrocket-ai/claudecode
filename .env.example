ANTHROPIC_API_KEY=your_key_here
DATABASE_URL=sqlite:///./content.db

# ── Hetzner deploy: public hostname Caddy will provision TLS for ─────────
# Point this subdomain's A record at the Hetzner box's public IP,
# then `docker compose up -d` (see Deploy section in README).
DOMAIN=receptionist.example.com

# ── AI Receptionist (Vapi) ────────────────────────────────────────────────
# In the Vapi dashboard → your assistant:
#   - Advanced → Server URL: https://YOUR-DOMAIN/voice/vapi/webhook
#   - Advanced → Server URL Secret: any string; paste the same value below
#   - Assistant → Analysis: enable Summary + Structured Data
#     (fields: name, callback_number, reason)
#   - Phone Numbers → attach your Twilio number to the assistant
VAPI_SECRET=

# Where the call recap email is sent
RECEPTIONIST_EMAIL=

# SMTP (used by both the receptionist recap and the daily script digest)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
