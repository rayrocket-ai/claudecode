# =============================================
# AI Real Estate Document Generator - Config
# =============================================

# --- REQUIRED: Telegram Bot ---
TELEGRAM_BOT_TOKEN=

# --- REQUIRED: AI (Claude) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- REQUIRED: REALM / TRREB Login ---
REALM_USERNAME=
REALM_PASSWORD=
REALM_URL=https://torontomls.net
REALM_SSO_URL=https://sso.ampre.ca/realms/trreb/protocol/openid-connect/auth

# --- REQUIRED: Brokerage Info ---
BROKERAGE_NAME=
BROKERAGE_PHONE=
BROKERAGE_FAX=
BROKERAGE_EMAIL=
BROKERAGE_ADDRESS=

# --- OPTIONAL: Access Control ---
# Comma-separated Telegram user IDs. Empty = allow all.
AUTHORIZED_USER_IDS=

# --- OPTIONAL: Browser Settings ---
BROWSER_HEADLESS=true
BROWSER_SLOWMO=100

# --- OPTIONAL: DocuSign ---
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_PRIVATE_KEY_PATH=
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi

# --- OPTIONAL: Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- OPTIONAL: SkySlope ---
SKYSLOPE_API_KEY=
SKYSLOPE_API_URL=https://api.skyslope.com

# --- OPTIONAL: Video pipeline (ElevenLabs Scribe for verbatim transcripts) ---
# Required only when running transcribe.py --engine scribe.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# --- OPTIONAL: GitHub releases (for studio.py pull) ---
# Required only if the repo is private. Fine-grained token with
# "Contents: Read" on rayrocket-ai/claudecode is enough.
GITHUB_TOKEN=
GITHUB_REPO=rayrocket-ai/claudecode
