APP_NAME="Realty Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=realty_platform
DB_USERNAME=root
DB_PASSWORD=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Elasticsearch
ELASTICSEARCH_HOST=127.0.0.1
ELASTICSEARCH_PORT=9200

# TRREB REALM SSO
REALM_AUTH_URL=https://identity.trreb.ca/auth/realms/TRREB
REALM_CLIENT_ID=your_client_id
REALM_USERNAME=your_username
REALM_PASSWORD=your_password

# MLS/RETS Data Feed
MLS_FEED_URL=https://data.trreb.ca/api/v1
MLS_API_KEY=
MLS_API_SECRET=

# Mapbox (for geocoding only - map tiles are self-hosted)
MAPBOX_ACCESS_TOKEN=your_mapbox_token

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@yourplatform.com"
MAIL_FROM_NAME="${APP_NAME}"

# JWT / Auth
JWT_SECRET=
JWT_TTL=1440

# AWS S3 (property images)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ca-central-1
AWS_BUCKET=realty-platform-images

# Tile Server
TILE_SERVER_URL=http://localhost:8080
