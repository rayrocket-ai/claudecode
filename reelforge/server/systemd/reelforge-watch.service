[Unit]
Description=ReelForge inbox watcher (pre-warms transcription and analysis)
Documentation=https://github.com/rayrocket-ai/claudecode/tree/main/reelforge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=%h/reelforge
Environment=REELFORGE_ROOT=%h/reelforge
ExecStart=%h/reelforge/.venv/bin/reelforge watch --root %h/reelforge

# The whole point of pre-warming is that it happens invisibly. This box runs
# other things; transcription must never be the reason they get slow.
Nice=15
IOSchedulingClass=idle
CPUWeight=20
IOWeight=20

# Transcription is memory-hungry and a runaway model load should not take the
# machine down with it. Tune upward if you move to a larger box.
MemoryMax=8G
MemoryHigh=6G

Restart=on-failure
RestartSec=10s
# Give up after repeated rapid failures rather than looping forever on a
# genuinely broken install -- check `journalctl -u reelforge-watch` when this trips.
StartLimitIntervalSec=300
StartLimitBurst=5

# Filesystem containment: the watcher reads and writes its own tree, nothing else.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/reelforge
PrivateTmp=true
NoNewPrivileges=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=reelforge-watch

[Install]
WantedBy=multi-user.target
